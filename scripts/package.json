{
  "name": "aevia-export-pdf",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone PDF export for Aevia photobooks. Run from any machine with Node 18+.",
  "scripts": {
    "pdf": "node export-pdf.js --mode preview --order",
    "pdf-print": "node export-pdf.js --mode print --order"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.0.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.33.5"
  }
}
