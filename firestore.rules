rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      // Staff allowlist — must match STAFF_EMAILS in functions/index.js.
      // Customer flows (preview, approve, pay, book-save) all go through
      // Cloud Functions (admin SDK), which bypass these rules — so customers
      // never touch Firestore directly and need no rule here.
      function isStaff() {
        return request.auth != null
          && request.auth.token.email in ['evg.myasin@gmail.com', 'xenia@aevia.at', 'claude-test@aevia.at'];
      }

      allow read:   if isStaff();
      allow update: if isStaff();
      allow create, delete: if false;
    }
  }
}
