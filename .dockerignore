# Cloud Build uploads the whole context; the Dockerfile only needs
# services/pdf-renderer/, scripts/export-pdf.js, and assets/. Exclude the rest
# to keep uploads small and builds fast. functions/pdf-render-utils.js is the one
# exception: the renderer requires it (#138).
.git
.claude
**/node_modules
sessions
qa
docs
tests
motif-engine
pages
functions
!functions/pdf-render-utils.js
pdf-out
*.md
assets/mockup example
# Website-only images the renderer never reads.
# Excluding these three fixed "Container import failed" in S193. The likely culprit is
# the non-ASCII folder name (dorottya-juhász); not confirmed which of the three it was.
assets/artists
assets/about us photos
assets/packaging
