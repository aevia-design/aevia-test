# Secret credentials — NEVER commit these
functions/.env
functions/serviceAccountKey.json
motif-engine/.env
aevia-uploads-*.json
qa/.env
# Minted customer-preview token URLs (qa/p1-preview-token.mjs). Live access tokens
# to a real order — its own comment said "gitignored-ish", but nothing ignored them.
qa/.preview-url-*.txt

# QA test photo libraries — real photos, local-only (privacy + size)
qa/test-photos/
qa/*.zip

# Dependencies — too large, reinstalled with `npm install`
node_modules/
functions/node_modules/

# Large assets — over Cloudflare Pages 25MB limit
assets/business plan/
assets/test photos/
# mockup-template PSDs (46–83MB) + SVGs — local-only source for the offline compose scripts
assets/mockup example/

# PDF export test output
pdf-out/

# QA run artefacts — screenshots/logs accumulate per run, not source
sessions/qa-runs/

# Local Claude config / worktrees — not part of the project
.claude/

# OS junk
desktop.ini
.DS_Store
Thumbs.db

# composed mockup outputs (review artefacts, regenerate offline)
# anchored to repo root so the web-ready assets under assets/images/mockups/ are NOT ignored
/mockups/
firebase-debug.log

# DNS zone exports + dashboard screenshots gathered for the aevia.at migration
# (infrastructure detail; keep local — see docs/briefs/domain-migration.md)
docs/Zone file for aevia.at.txt
docs/aevia.at.zone
docs/*.zone
docs/Brevo.png
docs/Cloudflare*.txt
docs/cloudflare-export*

# Excel lock/temp files
~$*.xlsx
~$*.xls

# Business-case model — openpyxl rewrites the whole binary on every edit, so it
# showed as modified constantly and every save was a full 79K blob in history.
# Untracked from S156; the last tracked version is in commit 0edb8ee if needed.
# NOTE: this file is no longer backed up by git — keep a copy elsewhere.
assets/Aevia - Business case v*.xlsx
